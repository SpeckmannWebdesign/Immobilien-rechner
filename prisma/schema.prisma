// Immobilien-Rechner SaaS — Datenbank-Schema
// Betreiber: Speckmann Webdesign GmbH

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============================================
// Auth (NextAuth.js v5)
// ============================================

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  // Profil-Felder für Rechnungen
  company       String?   // Firma (optional)
  vatId         String?   // USt-IdNr (optional)
  street        String?   // Rechnungsadresse
  city          String?
  zip           String?
  country       String    @default("DE")

  // Admin-Flag
  isAdmin       Boolean   @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts     Account[]
  sessions     Session[]
  subscription Subscription?
  embedKeys    EmbedKey[]
  toolUsages   ToolUsage[]
  leadCaptures LeadCapture[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ============================================
// Abo-Verwaltung (Stripe)
// ============================================

enum Plan {
  STARTER
  PRO
  BUSINESS
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  CANCELLED
  PAST_DUE
  UNPAID
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String             @unique
  stripeSubscriptionId String?            @unique
  plan                 Plan               @default(STARTER)
  status               SubscriptionStatus @default(TRIAL)
  interval             String             @default("month") // "month" oder "year"
  trialEndsAt          DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Embed-System
// ============================================

model EmbedKey {
  id             String   @id @default(cuid())
  userId         String
  apiKey         String   @unique @default(uuid())
  name           String   @default("Standard") // Bezeichnung für den Key
  allowedDomains String[] // Erlaubte Domains
  selectedTool   String?  // Tool-Slug (Pro: 1 Tool, Business: null = alle)
  isActive       Boolean  @default(true)

  // Styling
  primaryColor   String   @default("#2563eb") // Standard: Blau
  darkMode       Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// Analytics & Lead-Capture
// ============================================

model ToolUsage {
  id       String   @id @default(cuid())
  userId   String?
  toolSlug String
  source   String   @default("dashboard") // "dashboard", "embed", "public"
  usedAt   DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([toolSlug])
  @@index([userId])
  @@index([usedAt])
}

model LeadCapture {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  toolSlug   String
  resultData Json?    // Berechnungsergebnis als JSON
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email])
  @@index([toolSlug])
}

// ============================================
// Konfiguration (Admin-verwaltete Werte)
// ============================================

model TaxRate {
  id           String @id @default(cuid())
  bundesland   String @unique
  rate         Float  // z.B. 6.5 für 6,5%
  displayOrder Int    @default(0)

  updatedAt DateTime @updatedAt
}

model AppConfig {
  id    String @id @default(cuid())
  key   String @unique
  value String
  label String // Beschreibung für Admin-Dashboard

  updatedAt DateTime @updatedAt
}
